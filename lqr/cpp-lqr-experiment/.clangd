CompileFlags:
  CompilationDatabase: No
  Compiler: clang++
  Add:
    - -I/Users/emichaelbarnettgmail.com/CLionProjects/betaflight/src/main/flight/lqr/cpp-lqr-experiment/include
    - -I/opt/homebrew/Cellar/eigen/3.4.0_1/include/eigen3
    - -DEIGEN_MPL2_ONLY
    - -DEIGEN_NO_DEBUG
    - -DEIGEN_DONT_PARALLELIZE
    - -DMP_UNITS_HOSTED=1
    - -std=c++20

Index:
  Background: Build

Diagnostics:
  ClangTidy:
    Add:
      - modernize-*
      - performance-*
      - readability-*
      - bugprone-*

InlayHints:
  Enabled: No

Completion:
  DetailedLabel: No 